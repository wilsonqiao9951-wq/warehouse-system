# Copy to .env.production, replace every CHANGE_ME value, then restrict file permissions.
APP_NAME=OpenPartsFlow
APP_ENV=production
DEPLOYMENT_REGION=us-east-1
APP_DEBUG=false
LOG_LEVEL=INFO

POSTGRES_DB=openpartsflow
POSTGRES_OWNER_USER=openpartsflow_owner
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_LONG_OWNER_DATABASE_PASSWORD
POSTGRES_APP_USER=openpartsflow_app
POSTGRES_APP_PASSWORD=CHANGE_ME_GENERATE_A_DIFFERENT_LONG_APP_DATABASE_PASSWORD
MIGRATION_DATABASE_URL=postgresql+psycopg://openpartsflow_owner:CHANGE_ME_GENERATE_A_LONG_OWNER_DATABASE_PASSWORD@db:5432/openpartsflow
DATABASE_URL=postgresql+psycopg://openpartsflow_app:CHANGE_ME_GENERATE_A_DIFFERENT_LONG_APP_DATABASE_PASSWORD@db:5432/openpartsflow

JWT_SECRET_KEY=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_PRINCIPAL_FAILURES=10
LOGIN_RATE_LIMIT_SOURCE_FAILURES=50
PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=3600
PASSWORD_RESET_PRINCIPAL_REQUESTS=3
PASSWORD_RESET_SOURCE_REQUESTS=20
MFA_ENCRYPTION_KEYS=CHANGE_ME_GENERATE_A_32_BYTE_BASE64_KEY
MFA_CHALLENGE_EXPIRE_MINUTES=5
MFA_ENROLLMENT_EXPIRE_MINUTES=10
MFA_MAX_ATTEMPTS=5
# Enable only after configuring a verified sender and TLS-protected SMTP relay.
PASSWORD_RESET_EMAIL_ENABLED=false
INVITATION_EMAIL_ENABLED=false
AUTH_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
INVITATION_EXPIRE_HOURS=72
RBAC_ENFORCE=true
LEGACY_HEADER_AUTH=false

# Public URL presented to users. TLS terminates at the enterprise gateway/load balancer.
FRONTEND_PUBLIC_URL=https://parts.example.com
CORS_EXTRA_ORIGINS=https://parts.example.com
PUBLIC_API_BASE_URL=/api
PUBLIC_AUTH_SESSION_MODE=auto
OPENPARTSFLOW_PORT=8080

DATA_EXPORT_PUBLIC_FILES_ROOT=/app/data/uploads
DATA_EXPORT_PRIVATE_FILES_ROOT=/app/data/private
DATA_RESTORE_ROLLBACK_FILES_ROOT=/app/data/rollbacks

INTEGRATION_DELIVERY_ENABLED=true
INTEGRATION_DELIVERY_POLL_SECONDS=30
BILLING_RECONCILIATION_ENABLED=true
BILLING_RECONCILIATION_POLL_SECONDS=3600
# Shared PostgreSQL leases elect one scheduler across replicated API instances.
WORKER_LEASE_SECONDS=90
WORKER_LEASE_HEARTBEAT_SECONDS=10
BILLING_WEBHOOK_SECRET=

# Optional Stripe Billing adapter. Keep disabled until live/test secrets and
# server-owned recurring Price IDs have been configured.
STRIPE_BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE_URL=https://api.stripe.com
STRIPE_API_VERSION=2026-02-25.clover
STRIPE_REQUEST_TIMEOUT_SECONDS=15
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=
STRIPE_AUTOMATIC_TAX_ENABLED=true
STRIPE_TAX_ID_COLLECTION_ENABLED=true

# Use an immutable release or commit identifier for deployable image tags.
IMAGE_TAG=CHANGE_ME_RELEASE_OR_COMMIT
VCS_REF=CHANGE_ME_FULL_COMMIT_SHA
