APP_NAME=OpenPartsFlow
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./openpartsflow.db
RBAC_ENFORCE=true
LEGACY_HEADER_AUTH=false
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
INVITATION_EXPIRE_HOURS=72
FRONTEND_PUBLIC_URL=http://localhost:3000
MAX_IMAGE_UPLOAD_BYTES=10485760
# Optional real photo analysis. Disabled until a server-side OpenAI API key is set.
VISION_RECOGNITION_ENABLED=false
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com
VISION_RECOGNITION_MODEL=gpt-5.6-terra
# Use original for label OCR and small part-number text.
VISION_RECOGNITION_IMAGE_DETAIL=original
VISION_RECOGNITION_TIMEOUT_SECONDS=45
VISION_RECOGNITION_MAX_OUTPUT_TOKENS=1600
VISION_RECOGNITION_MAX_CATALOG_PARTS=250
VISION_RECOGNITION_STALE_MINUTES=5
MAX_KNOWLEDGE_MEDIA_UPLOAD_BYTES=52428800
MAX_ANALYTICS_EXPORT_ROWS=100000
MAX_IMPORT_UPLOAD_BYTES=5242880
INTEGRATION_DELIVERY_ENABLED=true
INTEGRATION_DELIVERY_POLL_SECONDS=30
CUSTOM_DOMAIN_DNS_RESOLVER_URL=https://cloudflare-dns.com/dns-query
CUSTOM_DOMAIN_VERIFICATION_COOLDOWN_SECONDS=30
BILLING_RECONCILIATION_ENABLED=true
BILLING_RECONCILIATION_POLL_SECONDS=3600
BILLING_NOTICE_WINDOW_DAYS=7
# Required for /api/billing/webhooks/generic. Use at least 32 random characters.
BILLING_WEBHOOK_SECRET=
BILLING_WEBHOOK_TOLERANCE_SECONDS=300
BILLING_WEBHOOK_MAX_BYTES=65536
# Stripe is disabled until server secrets and allowlisted Price IDs are configured.
STRIPE_BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE_URL=https://api.stripe.com
STRIPE_API_VERSION=2026-02-25.clover
STRIPE_REQUEST_TIMEOUT_SECONDS=15
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=
STRIPE_AUTOMATIC_TAX_ENABLED=true
STRIPE_TAX_ID_COLLECTION_ENABLED=true
DATA_EXPORT_PUBLIC_FILES_ROOT=uploads
DATA_EXPORT_PRIVATE_FILES_ROOT=private_uploads
MAX_DATA_EXPORT_BYTES=536870912
MAX_AUDIT_EXPORT_ROWS=100000
OPERATIONS_REQUEST_WINDOW_SECONDS=300
OPERATIONS_BACKUP_WARNING_DAYS=7
OPERATIONS_STALE_PROCESSING_MINUTES=10
OPERATIONS_SLOW_REQUEST_MS=1000
MAX_DATA_RESTORE_ARCHIVE_BYTES=553648128
MAX_DATA_RESTORE_UNCOMPRESSED_BYTES=553648128
MAX_DATA_RESTORE_ROLLBACK_BYTES=67108864
DATA_RESTORE_ROLLBACK_FILES_ROOT=restore_rollbacks
MAX_DATA_RESTORE_FILE_ROLLBACK_BYTES=1073741824
# Optional: comma-separated frontend origins for CORS (Cloudflare Tunnel / public HTTPS), e.g.:
# CORS_EXTRA_ORIGINS=https://abc123.trycloudflare.com,https://app.example.com
CORS_EXTRA_ORIGINS=
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/openpartsflow
