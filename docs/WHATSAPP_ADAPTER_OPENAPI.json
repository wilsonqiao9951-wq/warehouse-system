                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-User-Id"
            }
          },
          {
            "name": "X-Device-Token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Device-Token"
            }
          },
          {
            "name": "X-Claim-Version",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Claim-Version"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/channels/whatsapp/events": {
      "post": {
        "summary": "Event",
        "operationId": "event_api_channels_whatsapp_events_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "provider_id": {
                    "type": "string",
                    "maxLength": 100,
                    "minLength": 1,
                    "title": "Provider Id"
                  },
                  "recipient_id": {
                    "type": "string",
                    "maxLength": 100,
                    "minLength": 1,
                    "title": "Recipient Id"
                  },
                  "sender_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{5,19}$",
                    "title": "Sender Id"
                  },
                  "event_id": {
                    "type": "string",
                    "maxLength": 200,
                    "minLength": 8,
                    "title": "Event Id"
                  },
                  "chat_type": {
                    "type": "string",
                    "const": "individual",
                    "title": "Chat Type"
                  },
                  "action": {
                    "type": "string",
                    "enum": [
                      "bind",
                      "query",
                      "claim",
                      "report_draft",
                      "report_confirm"
                    ],
                    "title": "Action"
                  },
                  "user_text": {
                    "type": "string",
                    "maxLength": 5000,
                    "title": "User Text",
                    "default": ""
                  },
                  "arguments": {
                    "type": "object",
                    "title": "Arguments"
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "provider_id",
                  "recipient_id",
                  "sender_id",
                  "event_id",
                  "chat_type",
                  "action"
                ],
                "title": "Message"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
