    "/api/channels/whatsapp/pilots/{sender_id}": {
      "delete": {
        "summary": "Revoke Pilot",
        "operationId": "revoke_pilot_api_channels_whatsapp_pilots__sender_id__delete",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "sender_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Sender Id"
            }
          },
          {
            "name": "reason",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Reason"
            }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
