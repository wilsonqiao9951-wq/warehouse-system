                }
              }
            }
          }
        }
      }
    },
    "/api/channels/whatsapp/bindings/{sender_id}": {
      "delete": {
        "summary": "Revoke",
        "operationId": "revoke_api_channels_whatsapp_bindings__sender_id__delete",
