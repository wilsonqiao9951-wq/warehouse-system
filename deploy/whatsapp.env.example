# Preparation only. Copy outside Git; permissions 0600. Keep both activation switches false.
META_DEPLOYMENT_MODE=disabled
META_LIVE_SEND_ENABLED=false
WHATSAPP_ADAPTER_ENABLED=false
META_ADAPTER_URL=http://adapter:8011
WHATSAPP_DOMAIN=whatsapp.your-domain.example
# Production inventory; disabled mode does not read credentials.
META_WABA_ID=REPLACE_BEFORE_FUTURE_ACTIVATION
META_PHONE_NUMBER_ID=REPLACE_BEFORE_FUTURE_ACTIVATION
META_GRAPH_VERSION=VERIFY_SUPPORTED_VERSION_BEFORE_ACTIVATION
# Secret files must live outside repository/image with 0400/0600 permissions.
META_APP_SECRET_FILE=/run/secrets/meta_app_secret
META_VERIFY_TOKEN_FILE=/run/secrets/meta_verify_token
META_ACCESS_TOKEN_FILE=/run/secrets/meta_access_token
WHATSAPP_SIGNING_SECRET_FILE=/run/secrets/whatsapp_signing_secret

# Production factory is implemented, but both activation gates must stay false.
META_CHANNEL_ENABLED=false
META_BRIDGE_STATE=/state/bridge.sqlite3
WHATSAPP_ADAPTER_STATE=/adapter-state/channel.sqlite3
# Host-side *_FILE values for the optional production overlay must be existing absolute files.
# Provision regular files 0400/0600 and state directories 0700; never use symlinks.
