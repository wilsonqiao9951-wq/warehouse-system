FROM postgres:16-alpine

RUN apk add --no-cache python3 \
    && addgroup -g 10001 -S openpartsflow \
    && adduser -u 10001 -S -D -H -G openpartsflow openpartsflow \
    && mkdir -p /opt/openpartsflow /source/public /source/private /source/rollback /recovery /reports /target \
    && chown -R 10001:10001 /opt/openpartsflow /source /recovery /reports /target

COPY --chown=10001:10001 scripts/platform_recovery.py /opt/openpartsflow/platform_recovery.py

USER 10001:10001
WORKDIR /opt/openpartsflow
ENTRYPOINT ["python3", "/opt/openpartsflow/platform_recovery.py"]
